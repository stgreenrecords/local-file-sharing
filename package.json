{
  "name": "omnicommander",
  "version": "0.1.0",
  "description": "Cross-platform dual-pane file commander with LAN machine discovery",
  "main": "./out/main/index.js",
  "author": "OmniCommander",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "bonjour-service": "1.3.0",
    "electron": "33.2.1",
    "material-symbols": "0.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  }
}
